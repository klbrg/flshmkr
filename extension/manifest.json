{
  "manifest_version": 3,
  "name": "flshmkr",
  "version": "1.7.1",
  "description": "Generate Anki flashcards from O'Reilly Learning highlights",
  "permissions": ["contextMenus", "activeTab", "storage"],
  "host_permissions": [
    "https://learning.oreilly.com/*",
    "https://learn.microsoft.com/*",
    "https://git-scm.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://learning.oreilly.com/*",
        "https://learn.microsoft.com/*",
        "https://git-scm.com/*"
      ],
      "js": ["sidebar.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "flshmkr - toggle sidebar"
  },
  "commands": {
    "rephrase-selection": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      },
      "description": "Rephrase selected text"
    },
    "toggle-sidebar": {
      "suggested_key": {
        "default": "Ctrl+Shift+O",
        "mac": "Command+Shift+O"
      },
      "description": "Toggle the flshmkr sidebar"
    }
  }
}
